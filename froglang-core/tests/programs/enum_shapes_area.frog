data Color is Red | Green | Blue

data Shape(color: Color) is
    Circle(r: Int) | Rect(w: Int, h: Int)

func area(s: Shape): Int = match s {
    is Circle(r) then r * r * 3
    is Rect(w, h) then w * h
}

let shapes = [Circle(color=Red, r=2), Rect(color=Green, w=3, h=4), Circle(color=Blue, r=1)]

mut total_area = 0
for s in shapes do { total_area = total_area + area(s) }

// Common field is readable without matching, and mixes into the total
// to exercise `s.color` -> tag-independent access alongside the match.
let red_bonus = if shapes[0].color is Red then 100 else 0

total_area + red_bonus
