data Student(name: Str, score: Int)
data Stats(count: Int, total: Int, highest: Int)

// `stats` (the parameter) is a copy of the caller's argument (value
// semantics) and, until `mut` parameters exist (MUTABILITY.md stage 4),
// immutable itself — `mut r = stats` takes an explicit local mutable copy
// to mutate via the rebind sugar, which still never affects the caller's
// binding.
func record(stats: Stats, score: Int): Stats = {
    mut r = stats
    r.highest = if score > r.highest then score else r.highest
    r.count = r.count + 1
    r.total = r.total + score
    r
}

let students = [Student(name="Alice", score=92), Student(name="Bob", score=58), Student(name="Cara", score=77), Student(name="Dev", score=41), Student(name="Eve", score=88)]

let passing = [for s in students if s.score >= 60 do s]

mut stats = Stats(count=0, total=0, highest=0)
for s in passing do { stats = record(stats, s.score) }

stats.total / stats.count
