// Order-pipeline benchmark — exercises structs, unions + match, `?`/`catch`
// error propagation, and lists.
//
// The shape is deliberately mundane: build a catalogue of line items, then
// repeatedly filter it into a batch and price every item in that batch,
// where pricing means classifying the item into a discount variant, matching
// on that variant, and validating the result through a fallible function
// using `?`.  Per round this allocates a fresh list (GC pressure) and one
// boxed union value per item for the discount, plus (on the — never taken —
// error path) a boxed `PricingError`, on top of struct field access and
// integer arithmetic in the inner loop.
//
// `Category` and `Discount` are `data X is A | B | ...` unions (ERRORS.md:
// there is no separate enum mechanism, unions are the one sum type) and
// `PricingError` is a `data ... provides Error` — the `Error` trait is
// granted by that clause, not structural, so `checked_gross`'s `?` and the
// call site's `catch` both typecheck only because of it.
//
// The sibling orders.{rs,go,py,lua} files implement exactly this, and
// run_comparisons.sh reads the two loop bounds below out of *this* file and
// passes them to the others, so all five stay in lockstep. The catalogue's
// gross is always non-negative by construction, so the error branch below
// never actually fires and every implementation still produces the same
// total — the sibling files don't need a fallible path of their own to match.
//
// Run: cargo run --release -- run benches/orders.frog

data Category is Food | Book | Electronics | Toy

data Item(sku: Int, category: Category, qty: Int, unit_price: Int)

data Discount is
    NoDiscount | Percent(pct: Int) | Flat(amount: Int) | BulkOver(min_qty: Int, pct: Int)

data PricingError(msg: Str) provides Error

// froglang has no `%` operator yet, so modulo is spelled out.  Every operand
// here is non-negative, so truncating and flooring division agree and the
// other five implementations can use their native `%`.
func modn(x: Int, n: Int): Int = x - (x / n) * n

// Knuth multiplicative hash — gives each sku a deterministic but unpatterned
// category / quantity / price, so no branch in the inner loop is predictable.
func hash(i: Int): Int = modn(i * 2654435761 + 1013904223, 2147483647)

func category_of(h: Int): Category = {
    let k = modn(h, 4)
    if k == 0 then Food
    else if k == 1 then Book
    else if k == 2 then Electronics
    else Toy
}

// Pricing policy: which discount an item qualifies for.  Returns an enum
// rather than a number so the caller has to match on it.
func discount_for(it: Item): Discount = match it.category {
    is Food then if it.qty >= 6 then BulkOver(min_qty=6, pct=5) else NoDiscount
    is Book then Percent(pct=10)
    is Electronics then if it.unit_price > 3000 then Flat(amount=250) else Percent(pct=3)
    is Toy then BulkOver(min_qty=3, pct=15)
}

func apply(d: Discount, gross: Int, qty: Int): Int = match d {
    is NoDiscount then gross
    is Percent(pct) then gross - gross * pct / 100
    is Flat(amount) then if gross > amount then gross - amount else 0
    is BulkOver(min_qty, pct) then if qty >= min_qty then gross - gross * pct / 100 else gross
}

// A corrupted catalogue entry could in principle produce a negative gross;
// refuse to price it rather than silently returning a wrong total.
func checked_gross(gross: Int): Int | PricingError =
    if gross < 0 then PricingError(msg="negative gross") else gross

// `?` propagates `checked_gross`'s error member straight through — no
// conversion, since `PricingError` is already a member of the declared
// return union (ERRORS.md's free widening).
func price_item(it: Item): Int | PricingError = {
    let gross = checked_gross(it.qty * it.unit_price)?
    apply(discount_for(it), gross, it.qty)
}

let items = [for i in 0..2000 do Item(sku=i, category=category_of(hash(i)), qty=1 + modn(hash(i + 7), 9), unit_price=100 + modn(hash(i + 13), 5000))]

let total = 0
for round in 0..2000 do {
    // Rotating the filter by `round` keeps a different two-thirds of the
    // catalogue in each batch, so the list can't be hoisted out of the loop.
    let batch = [for it in items if modn(it.sku + round, 3) != 0 do it]
    for it in batch do {
        // `catch` falls back to 0 on error — never taken here, but it's the
        // call site that turns `Int | PricingError` back into a plain `Int`.
        total = total + (price_item(it) catch 0)
    }
}

total
